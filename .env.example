# Copie este arquivo para .env:
#   copy .env.example .env

POSTGRES_DB=quebra_codigo
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=qc_pass

# Links dentro dos e-mails (cadastro / esqueci a senha).
APP_BASE_URL=http://localhost:8150

# --- Padrao atual: Mailhog (inbox local) ---
# Abra http://localhost:8025 depois de cadastrar.
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=nao-responda@quebracodigo.local
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=nao-responda@quebracodigo.local

# --- Futuro: SMTP real (Gmail pessoal ou Brevo) ---
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=seu-email@gmail.com
# SPRING_MAIL_PASSWORD=senha-de-app-16-letras
